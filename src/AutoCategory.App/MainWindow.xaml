<Window x:Class="AutoCategory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catego"
        Width="1120" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ סרגל צד ═══════ -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,26">
                    <Image Source="Assets/logo.png" Width="36" Height="36" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <TextBlock Text="catego" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="קטגוריה אוטומטית" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FlowDirection="RightToLeft" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True"
                                 Content="לוח בקרה" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="כללי קטגוריות" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSites" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="כללי אתרים" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTts" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="הקראה (TTS)" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavIgnore" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="רשימת התעלמות" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="יומן פעילות" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavKick" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="חיבור לקיק" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTest" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="מצב בדיקה" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="הגדרות" Checked="Nav_Checked" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <Border x:Name="ModeBadge" Background="#2A2410" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="ModeBadge_Click">
                        <StackPanel>
                            <TextBlock x:Name="ModeTitle" Text="מצב סימולציה" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock x:Name="ModeText" Text="לא מחובר לקיק – שינויים מדומים בלבד" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════ תוכן ═══════ -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
