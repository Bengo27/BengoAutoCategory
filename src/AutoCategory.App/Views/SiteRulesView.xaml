<UserControl x:Class="AutoCategory.App.Views.SiteRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="34,24,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="כללי אתרים" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="כשהדפדפן בחזית, התוכנה בודקת את כותרת הלשונית הפעילה. אם היא מכילה מילת מפתח מהרשימה – עוברים לקטגוריה שלה (למשל אתרי קזינו → Slots &amp; Casino). לשונית בלי כלל לא משנה כלום." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="הוסף" Command="{Binding AddCommand}" MinWidth="80" />
                <Button Content="ערוך" Command="{Binding EditCommand}" MinWidth="80" />
                <Button Style="{StaticResource DangerButton}" Content="מחק" Command="{Binding DeleteCommand}" MinWidth="80" />
            </StackPanel>
            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Content="שחזר את אתרי הקזינו המוכרים"
                    Command="{Binding AddCasinoDefaultsCommand}" />
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="מילת מפתח בלשונית" Binding="{Binding Keyword}" Width="2*" />
                <DataGridTextColumn Header="קטגוריה" Binding="{Binding Category}" Width="2*" />
                <DataGridTextColumn Header="מזהה בקיק" Binding="{Binding KickCategoryId}" Width="90" />
                <DataGridTextColumn Header="הערה" Binding="{Binding Notes}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding BrowsersText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
