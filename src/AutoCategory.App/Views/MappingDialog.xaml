<Window x:Class="AutoCategory.App.Views.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="כלל קטגוריה" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="HeaderText" Text="כלל קטגוריה" Style="{StaticResource PageTitle}" FontSize="20" />
        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,14"
                   Text="כשהקובץ הזה יהיה בחזית, התוכנה תציע לעבור לקטגוריה שתבחר." />

        <TextBlock Text="קובץ הרצה" Style="{StaticResource CardLabel}" />
        <TextBox x:Name="ExeBox" FlowDirection="LeftToRight" Margin="0,0,0,14" />

        <TextBlock Text="קטגוריה (כפי שהיא מופיעה בקיק)" Style="{StaticResource CardLabel}" />
        <TextBox x:Name="CategoryBox" FlowDirection="LeftToRight" Margin="0,0,0,6" TextChanged="CategoryBox_TextChanged" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" Text="קטגוריות קיימות (לחיצה לבחירה):" />
        <WrapPanel x:Name="KnownCategoriesPanel" Margin="-4,0,0,10" />

        <!-- חיפוש בקיק -->
        <Border x:Name="KickSearchPanel" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="חיפוש הקטגוריה בקיק" Style="{StaticResource CardLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="חפש בקיק" Click="KickSearch_Click" IsDefault="False" />
                    <TextBox x:Name="KickSearchBox" FlowDirection="LeftToRight" Margin="0,0,6,0" PreviewKeyDown="KickSearchBox_KeyDown" />
                </DockPanel>
                <TextBlock x:Name="KickSearchStatus" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                <WrapPanel x:Name="KickResultsPanel" Margin="-4,4,0,0" />
            </StackPanel>
        </Border>

        <Expander Header="אפשרויות מתקדמות" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="תנאי כותרת חלון (אופציונלי)" Style="{StaticResource CardLabel}" />
                <TextBox x:Name="TitleBox" FlowDirection="LeftToRight" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="הכלל יתאים רק אם הטקסט מופיע בכותרת החלון. שימושי לקבצים כלליים כמו javaw.exe." />

                <CheckBox x:Name="AmbiguousBox" Style="{StaticResource ToggleSwitch}" Content="קובץ דו-משמעי (ודאות 80%, לא נספר כמשחק ברקע)" Margin="0,0,0,12" />

                <TextBlock Text="מזהה קטגוריה בקיק (לשלב 2, לא חובה)" Style="{StaticResource CardLabel}" />
                <TextBox x:Name="KickIdBox" FlowDirection="LeftToRight" Margin="0,0,0,12" />

                <TextBlock Text="הערה" Style="{StaticResource CardLabel}" />
                <TextBox x:Name="NotesBox" />
            </StackPanel>
        </Expander>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ביטול" IsCancel="True" MinWidth="90" />
            <Button Style="{StaticResource PrimaryButton}" Content="שמור" IsDefault="True" MinWidth="90" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
