<UserControl x:Class="AutoCategory.App.Views.IgnoreListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="34,24,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="רשימת התעלמות" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="תוכנות ברשימה הזו לעולם לא ישנו קטגוריה, וגם לא יבטלו שינוי ממתין – Alt-Tab ל-OBS או לדיסקורד באמצע משחק לא ישפיע על כלום. דפדפנים ברשימה, אבל לשונית שיש לה כלל בעמוד &quot;כללי אתרים&quot; כן משנה קטגוריה." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="הוסף" MinWidth="80"
                        Command="{Binding AddCommand}" IsDefault="True" />
                <TextBlock DockPanel.Dock="Left" Text="קובץ הרצה:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Text="{Binding NewItem, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                         Margin="0,0,8,0" ToolTip="למשל: vlc.exe" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="הסר מהרשימה"
                            Command="{Binding RemoveCommand}" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Text="טיפ: אם מוסיפים כלל קטגוריה לתוכנה שברשימה, הכלל גובר והיא מוסרת מהרשימה." />
                </DockPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
