<UserControl x:Class="AutoCategory.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- ═══ כותרת + מתג אוטומטי ═══ -->
            <Grid Margin="6,0,6,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="לוח בקרה" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13"
                               Text="התוכנה מזהה את המשחק שבחזית ומציעה לשנות את קטגוריית הסטרים." />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="16,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="קטגוריה אוטומטית" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoEnabled, Mode=TwoWay}"
                                  ToolTip="כבוי = התוכנה רק מציעה שינוי ומחכה ללחיצה על 'שנה עכשיו'" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ באנר עדכון ═══ -->
            <Border Visibility="{Binding UpdateVisible, Converter={StaticResource BoolToVis}}"
                    Background="#1C2E17" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="6,0,6,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="עדכן עכשיו"
                            Command="{Binding UpdateCommand}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               Text="{Binding UpdateText}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ═══ באנר מצב בדיקה ═══ -->
            <Border Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVis}}"
                    Background="#16263A" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="6,0,6,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{StaticResource InfoBrush}"
                            Content="לניהול מצב בדיקה" Command="{Binding OpenTestModeCommand}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"
                               Text="מצב בדיקה פעיל – הזיהוי משתמש בתוכנות מדומות ולא בחלון האמיתי" />
                </DockPanel>
            </Border>

            <!-- ═══ שורה 1: תוכנה נוכחית + קטגוריה שזוהתה ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" BorderThickness="1"
                                    BorderBrush="{Binding KindBrush}">
                                <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding KindBrush}" />
                            </Border>
                            <TextBlock Text="תוכנה נוכחית" Style="{StaticResource CardLabel}" />
                        </DockPanel>
                        <TextBlock Text="{Binding AppTitle}" Style="{StaticResource CardValue}" FontSize="24" Margin="0,4,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Text="תהליך" Foreground="{StaticResource MutedBrush}" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessName}" FlowDirection="LeftToRight" TextAlignment="Right" />

                            <TextBlock Grid.Row="1" Text="קובץ הרצה" Foreground="{StaticResource MutedBrush}" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExecutableName}" FlowDirection="LeftToRight" TextAlignment="Right" />

                            <TextBlock Grid.Row="2" Text="כותרת חלון" Foreground="{StaticResource MutedBrush}" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WindowTitle}" ToolTip="{Binding WindowTitle}" />

                            <TextBlock Grid.Row="3" Text="זמן זיהוי" Foreground="{StaticResource MutedBrush}" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetectedAt}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                    Visibility="{Binding ShowAddMapping, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="הוסף כלל" Command="{Binding AddMappingCommand}" />
                            <Button Content="התעלם מהתוכנה הזו" Command="{Binding IgnoreCurrentCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="קטגוריה שזוהתה" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding DetectedCategory}" Style="{StaticResource CardValue}" FontSize="24" Margin="0,4,0,18" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConfidenceText}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="ודאות" Style="{StaticResource CardLabel}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Confidence, Mode=OneWay}" />
                        <TextBlock Text="{Binding ConfidenceHint}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ שורה 2: סטטוס + ספירה לאחור ═══ -->
            <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding PhaseBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding PhaseTitle}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                   TextWrapping="Wrap" Margin="20,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="20,12,0,0">
                            <TextBlock Text="קטגוריה נוכחית בסטרים:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentCategory}" FontWeight="SemiBold" FontSize="15" Margin="8,0,6,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Content="עדכן ידנית" Command="{Binding SetCurrentCategoryCommand}"
                                    ToolTip="אם שינית קטגוריה בעצמך בקיק – עדכן כאן" />
                        </StackPanel>

                        <ProgressBar Margin="20,16,0,0" Value="{Binding CountdownProgress, Mode=OneWay}"
                                     Foreground="{Binding PhaseBrush}"
                                     Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="16,18,0,0">
                            <Button Style="{StaticResource DangerButton}" Content="ביטול" Command="{Binding CancelCommand}" MinWidth="90" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ChangeNowText}" Command="{Binding ChangeNowCommand}" MinWidth="140" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,8,0" MinWidth="130"
                                Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CountdownText}" FontSize="56" FontWeight="Bold"
                                   Foreground="{Binding PhaseBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CountdownLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="150" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ שורה 3: פעילות אחרונה ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="פעילות אחרונה" Style="{StaticResource CardLabel}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding RecentLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Margin="8,6,8,0">
                <Run Text="שירות שינוי קטגוריה:" />
                <Run Text="{Binding ChangeServiceName, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
