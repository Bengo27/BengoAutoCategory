<UserControl x:Class="AutoCategory.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="80" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,24,34,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="הגדרות" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="השינויים נכנסים לתוקף אחרי לחיצה על 'שמור'." />

            <!-- ═══ זיהוי ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="זיהוי וטיימרים" Style="{StaticResource CardLabel}" />

                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding DetectionInterval, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="שניות" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="מרווח זיהוי" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="כל כמה זמן בודקים איזה חלון פעיל (1–30)." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding VerificationDelay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="שניות" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="זמן אימות לפני שינוי קטגוריה" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="כמה זמן משחק חדש צריך להיות בחזית לפני שמשנים קטגוריה (3–600)." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding MinBetweenChanges, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="שניות" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="זמן מינימלי בין שינויים" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="מונע החלפת קטגוריה שוב ושוב בזמן קצר. 0 = ללא הגבלה." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ═══ קטגוריה ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="קטגוריה" Style="{StaticResource CardLabel}" />

                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCategoryEnabled}" />
                        <StackPanel>
                            <TextBlock Text="קטגוריה אוטומטית" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="כבוי = התוכנה רק מציעה שינוי ומחכה ללחיצה על 'שנה עכשיו'." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBox DockPanel.Dock="Right" Width="200" FlowDirection="LeftToRight" Text="{Binding DefaultCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel>
                            <TextBlock Text="קטגוריית ברירת מחדל" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="הקטגוריה כשלא משחקים." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoDetectGames}" />
                        <StackPanel>
                            <TextBlock Text="זיהוי אוטומטי של משחקים חדשים" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="משחק בלי כלל שמותקן ב-Steam, Epic, Riot, EA, Ubisoft, GOG או Xbox – נוסף לו כלל לבד." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,4,0,10" IsEnabled="{Binding AutoDetectGames}">
                        <TextBlock Text="תיקיות משחקים נוספות (תיקייה בכל שורה)" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="למשל D:\Games – כל משחק שמותקן בתוכה ייחשב משחק." Style="{StaticResource RowHint}" Margin="0,2,0,6" />
                        <TextBox Text="{Binding ExtraGameFolders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 FlowDirection="LeftToRight" MinHeight="60" VerticalContentAlignment="Top" TextWrapping="NoWrap" />
                    </StackPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FallbackCategoryEnabled}" />
                        <StackPanel>
                            <TextBlock Text="קטגוריית גיבוי למשחק שאין לו קטגוריה בקיק" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="משחקי אינדי, דמואים וכו' – במקום שהשינוי ייכשל, הקטגוריה תהיה קטגוריית הגיבוי." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding FallbackCategoryEnabled}">
                        <TextBox DockPanel.Dock="Right" Width="200" FlowDirection="LeftToRight" Text="{Binding FallbackCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel>
                            <TextBlock Text="שם קטגוריית הגיבוי" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="ברירת מחדל: Games + Demos" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReturnToDefaultEnabled}" />
                        <StackPanel>
                            <TextBlock Text="חזרה לברירת המחדל כשסוגרים את המשחק" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="משחק מוכר שרץ ברקע מונע את החזרה." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ReturnToDefaultEnabled}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding ReturnToDefaultMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="דקות" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="זמן בלי משחק עד חזרה" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="(1–240)" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ═══ כללי ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="כללי" Style="{StaticResource CardLabel}" />

                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="הפעלה עם Windows (ממוזער למגש)" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" />
                        <StackPanel>
                            <TextBlock Text="סגירת החלון ממזערת למגש המערכת" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="הזיהוי ממשיך לפעול ברקע. יציאה מלאה – מהתפריט של האייקון ליד השעון." Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" />
                        <TextBlock Text="הצגת התראות" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SaveLogsToFile}" />
                        <TextBlock Text="שמירת יומן הפעילות לקובץ" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="שמור" MinWidth="110" Command="{Binding SaveCommand}" />
                <Button DockPanel.Dock="Right" Content="ברירות מחדל" Command="{Binding ResetCommand}" />
                <TextBlock Text="{Binding SavedText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Margin="0,24,0,0">
                <Button DockPanel.Dock="Right" Content="בדוק עדכונים" Command="{Binding CheckUpdatesCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="14" />
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Margin="0,24,0,0">
                <TextBlock Text="תיקיית הנתונים (כללים, הגדרות ויומנים):" Style="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding DataDirectory, Mode=OneWay}" FlowDirection="LeftToRight" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" Content="פתח" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
