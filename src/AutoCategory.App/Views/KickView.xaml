<UserControl x:Class="AutoCategory.App.Views.KickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,24,34,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="חיבור לקיק" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="אחרי ההתחברות, התוכנה תשנה את הקטגוריה בערוץ הקיק שלך באמת. ההתחברות נעשית בדף הרשמי של קיק – התוכנה לא רואה את הסיסמה שלך." />

            <!-- ═══ מצב ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Content="התחבר לקיק" Command="{Binding ConnectCommand}"
                                    Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVis}}" MinWidth="120" />
                            <Button Content="בטל" Command="{Binding CancelConnectCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Content="רענן" Command="{Binding RefreshCommand}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource DangerButton}" Content="התנתק" Command="{Binding DisconnectCommand}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="20,8,0,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ערוץ:" Foreground="{StaticResource MutedBrush}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding ChannelText}" Command="{Binding OpenChannelCommand}"
                                            Foreground="{StaticResource InfoBrush}" Padding="6,0" FlowDirection="LeftToRight" />
                                    <TextBlock Text="{Binding LiveText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="קטגוריה עכשיו בקיק:" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding KickCategory}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="20,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══ שינוי אמיתי ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LiveMode, Mode=TwoWay}" />
                        <StackPanel>
                            <TextBlock Text="שינוי קטגוריה אמיתי בקיק" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="כבוי = התוכנה ממשיכה לזהות ולרשום ביומן, אבל לא משנה כלום בערוץ (טוב לבדיקות)." />
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="בדוק ותקן מול קיק" Command="{Binding CheckRulesCommand}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="בדיקה ותיקון של שמות הקטגוריות" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="עובר על כל הכללים מול קיק: מוצא את השם הנכון גם אם הוא שונה מעט (למשל GTA V), מציע לתקן, ושומר את המזהה של כל קטגוריה." />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding RulesReport}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- ═══ התחברות מובנית / אפליקציה משלך ═══ -->
            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Margin="0,0,0,12"
                    Content="מתקדם: להשתמש באפליקציית קיק משלי" Command="{Binding ShowOwnAppSetupCommand}"
                    Visibility="{Binding ShowAdvancedLink, Converter={StaticResource BoolToVis}}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding ShowBackToBuiltIn, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="חזור להתחברות המובנית" Command="{Binding UseBuiltInCommand}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                               Text="אתה משתמש באפליקציית קיק משלך. אפשר לחזור להתחברות המובנית (בלי Client ID / Secret)." />
                </DockPanel>
            </Border>

            <!-- ═══ הגדרה ראשונית ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="הגדרה ראשונית (פעם אחת)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14"
                               Text="קיק דורש שלכל תוכנה תהיה &quot;אפליקציית מפתחים&quot;. יוצרים אחת בחשבון הקיק שלך – זה לוקח כמה דקות." />

                    <!-- שלב 1 -->
                    <TextBlock Text="שלב 1 – יצירת אפליקציה בקיק" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" LineHeight="22">
                        1. ודא שאימות דו-שלבי (2FA) מופעל בחשבון הקיק – בלי זה עמוד המפתחים לא נפתח.<LineBreak />
                        2. היכנס לעמוד המפתחים (כפתור למטה) ולחץ על יצירת אפליקציה חדשה.<LineBreak />
                        3. שם: למשל "Catego". תיאור: מה שתרצה.<LineBreak />
                        4. ב-Redirect URL הדבק בדיוק את הכתובת הזו:
                    </TextBlock>
                    <DockPanel Margin="18,6,0,6">
                        <Button DockPanel.Dock="Right" Content="העתק" Command="{Binding CopyRedirectCommand}" />
                        <TextBox Text="{Binding RedirectUri, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" LineHeight="22">
                        5. אם יש בחירת הרשאות (Scopes) – סמן לפחות: user:read, channel:read, channel:write.<LineBreak />
                        6. אם מבקשים Webhook – לא צריך, אפשר להשאיר כבוי/ריק.<LineBreak />
                        7. שמור. קיק יציג Client ID ו-Client Secret – העתק אותם לשלב 2.
                    </TextBlock>
                    <Button HorizontalAlignment="Left" Margin="14,10,0,18" Content="פתח את עמוד המפתחים של קיק" Command="{Binding OpenDeveloperPageCommand}" />

                    <!-- שלב 2 -->
                    <TextBlock Text="שלב 2 – פרטי האפליקציה" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Client ID" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Client Secret" VerticalAlignment="Center" />
                        <PasswordBox x:Name="SecretBox" Grid.Row="1" Grid.Column="1" FlowDirection="LeftToRight" Margin="0,4"
                                     PasswordChanged="SecretBox_PasswordChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" Margin="0,4,0,0">
                            <Run Text="מצב:" />
                            <Run Text="{Binding CredentialsText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="106,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="שמור פרטים" Command="{Binding SaveCredentialsCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                               Text="ה-Client Secret נשמר מוצפן (Windows DPAPI) ורק המשתמש שלך במחשב הזה יכול לפענח אותו. אל תשתף אותו עם אף אחד." />

                    <!-- שלב 3 -->
                    <TextBlock Text="שלב 3 – לחץ &quot;התחבר לקיק&quot; למעלה" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13"
                               Text="ייפתח דף של קיק בדפדפן. מאשרים את ההרשאות, ואחרי כמה שניות התוכנה תציג &quot;מחובר&quot;." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
