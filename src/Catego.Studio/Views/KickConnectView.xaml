<UserControl x:Class="Catego.Studio.Views.KickConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,24,34,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="חיבור לקיק" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Catego Studio מתחבר לקיק בנפרד מ-Catego, עם הרשאה לנהל פרסי נקודות (בשביל ההקראה). ההתחברות נעשית בדף הרשמי של קיק." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Content="התחבר לקיק" Command="{Binding ConnectCommand}" MinWidth="120"
                                    Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}" />
                            <Button Content="בטל" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource DangerButton}" Content="התנתק" Command="{Binding DisconnectCommand}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,6,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{Binding ChannelText}" Command="{Binding OpenChannelCommand}"
                                    Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Left" Margin="14,6,0,0" FlowDirection="LeftToRight"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="20,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
