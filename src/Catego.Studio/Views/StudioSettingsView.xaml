<UserControl x:Class="Catego.Studio.Views.StudioSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,24,34,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="הגדרות" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="השינויים נשמרים מיד." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="כללי" Style="{StaticResource CardLabel}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="הפעלה עם Windows (ממוזער למגש)" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" />
                        <StackPanel>
                            <TextBlock Text="סגירת החלון ממזערת למגש" FontSize="14" />
                            <TextBlock Text="ההקראה והווידג'טים ממשיכים לפעול ברקע." Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" />
                        <TextBlock Text="התראות ליד השעון" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="גרסה ועדכונים" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="14" Margin="0,8,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="בדוק עדכונים" Command="{Binding CheckUpdatesCommand}" />
                        <Button Content="פתח את תיקיית הנתונים" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
