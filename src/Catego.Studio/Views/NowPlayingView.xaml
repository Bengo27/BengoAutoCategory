<UserControl x:Class="Catego.Studio.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="34,24,34,24" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Now Playing" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                   Text="ווידג'ט ל-OBS שמציג את השיר שמתנגן בספוטיפיי. בקרוב!" />
        <Border Style="{StaticResource Card}">
            <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap"
                       Text="🎵 העמוד הזה ייפתח בגרסה הבאה של Catego Studio." />
        </Border>
    </StackPanel>
</UserControl>
